@param org.springframework.context.MessageSource messages
@param java.util.Locale locale
@param java.util.List<?> applications
<!doctype html><html lang="${locale.getLanguage()}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${messages.getMessage("profile.connectedApps", null, locale)} · ${messages.getMessage("common.brand", null, locale)}</title><link rel="stylesheet" href="/css/iam.css"></head><body>
<header class="topbar"><a class="brand" href="/">${messages.getMessage("common.brand", null, locale)}</a><nav class="nav"><a href="/">${messages.getMessage("common.home", null, locale)}</a><a href="/profile/edit">${messages.getMessage("profile.edit", null, locale)}</a><a href="/profile/password">${messages.getMessage("profile.changePassword", null, locale)}</a><a href="/profile/accounts">${messages.getMessage("profile.linkedAccounts", null, locale)}</a><a href="/profile/apps">${messages.getMessage("profile.connectedApps", null, locale)}</a><a href="/profile/apps?lang=en">${messages.getMessage("common.english", null, locale)}</a><a href="/profile/apps?lang=km">${messages.getMessage("common.khmer", null, locale)}</a></nav></header>
<main class="page"><div class="page-heading"><div><h1>${messages.getMessage("profile.connectedApps", null, locale)}</h1><p class="muted">${messages.getMessage("apps.description", null, locale)}</p></div></div>
    <section class="card">@if(applications.isEmpty())<div class="empty-state">${messages.getMessage("apps.unsupported", null, locale)}</div>@else @for(var app : applications)<div class="provider-card"><div><strong>${String.valueOf(app)}</strong></div></div>@endfor @endif</section>
</main><footer class="footer">${messages.getMessage("common.footer", null, locale)}</footer></body></html>
