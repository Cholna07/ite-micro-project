@param org.springframework.context.MessageSource messages
@param java.util.Locale locale
@param java.util.List<String> errors
@param boolean saved
@param String csrfToken
@param String csrfParameter
<!doctype html><html lang="${locale.getLanguage()}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${messages.getMessage("profile.changePassword", null, locale)} · ${messages.getMessage("common.brand", null, locale)}</title><link rel="stylesheet" href="/css/iam.css"><script defer src="/js/iam.js"></script></head><body>
<header class="topbar"><a class="brand" href="/">${messages.getMessage("common.brand", null, locale)}</a><nav class="nav"><a href="/">${messages.getMessage("common.home", null, locale)}</a><a href="/profile/edit">${messages.getMessage("profile.edit", null, locale)}</a><a href="/profile/password">${messages.getMessage("profile.changePassword", null, locale)}</a><a href="/profile/accounts">${messages.getMessage("profile.linkedAccounts", null, locale)}</a><a href="/profile/apps">${messages.getMessage("profile.connectedApps", null, locale)}</a><a href="/profile/password?lang=en">${messages.getMessage("common.english", null, locale)}</a><a href="/profile/password?lang=km">${messages.getMessage("common.khmer", null, locale)}</a></nav></header>
<main class="page"><div class="page-heading"><div><h1>${messages.getMessage("profile.changePassword", null, locale)}</h1><p class="muted">${messages.getMessage("password.securityHint", null, locale)}</p></div></div>
    @if(saved)<div class="alert success" role="status">${messages.getMessage("password.saved", null, locale)}</div>@endif
    @if(!errors.isEmpty())<div class="alert error" role="alert">@for(String error : errors)<div>${error}</div>@endfor</div>@endif
    <section class="card"><form method="post" action="/profile/password"><input type="hidden" name="${csrfParameter}" value="${csrfToken}">
        <div class="field"><label for="currentPassword">${messages.getMessage("password.current", null, locale)}</label><div class="input-wrap"><input id="currentPassword" type="password" name="currentPassword" autocomplete="current-password" required><button type="button" class="toggle-password" data-password-toggle data-show-label="${messages.getMessage("common.showPassword", null, locale)}" data-hide-label="${messages.getMessage("common.hidePassword", null, locale)}" aria-label="${messages.getMessage("common.showPassword", null, locale)}" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div></div>
        <div class="field"><label for="newPassword">${messages.getMessage("password.new", null, locale)}</label><div class="input-wrap"><input id="newPassword" type="password" name="newPassword" autocomplete="new-password" required><button type="button" class="toggle-password" data-password-toggle data-show-label="${messages.getMessage("common.showPassword", null, locale)}" data-hide-label="${messages.getMessage("common.hidePassword", null, locale)}" aria-label="${messages.getMessage("common.showPassword", null, locale)}" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div></div>
        <div class="field"><label for="confirmPassword">${messages.getMessage("password.confirm", null, locale)}</label><div class="input-wrap"><input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" required><button type="button" class="toggle-password" data-password-toggle data-show-label="${messages.getMessage("common.showPassword", null, locale)}" data-hide-label="${messages.getMessage("common.hidePassword", null, locale)}" aria-label="${messages.getMessage("common.showPassword", null, locale)}" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></div></div>
        <div class="form-actions"><button type="submit">${messages.getMessage("common.save", null, locale)}</button><a class="button secondary" href="/">${messages.getMessage("common.cancel", null, locale)}</a></div>
    </form></section>
</main><footer class="footer">${messages.getMessage("common.footer", null, locale)}</footer></body></html>
